# Base URL of the vision provider (the mock of `docker compose --profile mock up -d`)
ASSETFORGE_VISION_BASE_URL=http://127.0.0.1:11500
# Model name sent to the vision provider
ASSETFORGE_VISION_MODEL=mock-vision
# Artificial answer delay of the mock provider in milliseconds
MOCK_DELAY_MS=0
# Bearer key the mock provider requires (401 without it); leave empty for none. Example value only, never a real key.
# MOCK_API_KEY=test-key-not-real

# Vision provider: normally configured in the app's Settings screen; nothing has a default.
#
# Environment mode (development and tests). The app does not load this file: these two variables
# are read once from the environment of the Electron main process at start, for example from the
# shell that runs `pnpm dev`. When ASSETFORGE_VISION_BASE_URL is set - even to an empty value -
# the stored settings are ignored and cannot be saved, no API key is sent and the timeout is 120 s.
# An empty or unusable base URL (not http/https, user info, query or fragment) means "not configured".
# ASSETFORGE_VISION_MODEL becomes the default model for tagging and Image2Prompt; unset means none.
#
# Example for the mock of `docker compose --profile mock up -d`:
# ASSETFORGE_VISION_BASE_URL=http://127.0.0.1:11500
# ASSETFORGE_VISION_MODEL=mock-vision

# Mock provider settings, read by Docker Compose from .env.
# Artificial answer delay of the mock provider in milliseconds
MOCK_DELAY_MS=0
# Bearer key the mock provider requires (401 without it); leave empty for none. Example value only, never a real key.
# MOCK_API_KEY=test-key-not-real
# In environment mode the app sends no key, so a mock with MOCK_API_KEY answers every call with 401.
